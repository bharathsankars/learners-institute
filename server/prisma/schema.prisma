generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  RECOVERY_ADMIN
  ADMIN
  STAFF
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  COMPLETED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum FeePlanStatus {
  ACTIVE
  CANCELLED
}

enum AdmissionSource {
  WALK_IN
  ENQUIRY
  IMPORT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
}

model Session {
  tokenHash String @id
  userId String @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("sessions")
}

model Payment {
  id String @id @default(uuid()) @db.Uuid
  requestId String @unique @db.Uuid
  receiptNumber Int @unique @default(autoincrement())
  feePlanId String @db.Uuid
  amountPaise Int
  method PaymentMethod
  paidAt DateTime @db.Date
  reference String?
  notes String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  feePlan FeePlan @relation(fields: [feePlanId], references: [id], onDelete: Restrict)
  @@index([feePlanId])
  @@map("payments")
}

model User {
  id String @id @default(uuid()) @db.Uuid

  firstName String
  lastName  String

  username String @unique
  email    String @unique
  password String

  sessions Session[]
  studentImports StudentImportBatch[]
  instructedBatches Batch[]
  admittedStudents  Student[]
  activities        ActivityLog[]
  markedAttendance  Attendance[]

  lastLoginAt DateTime? @db.Timestamptz(3)

  role     UserRole @default(STAFF)
  isActive Boolean  @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([role])
  @@map("users")
}

// Who changed what in the admin, newest first on the Settings page.
model ActivityLog {
  id String @id @default(uuid()) @db.Uuid

  actorId String? @db.Uuid
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  // e.g. "student.created", "batch.student_added"
  action     String
  entityType String
  entityId   String?
  summary    String

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([entityType])
  @@index([actorId])
  @@map("activity_logs")
}

model InstituteSetting {
  id String @id @default(uuid()) @db.Uuid

  instituteName String
  phone         String?
  whatsapp      String?
  email         String?
  address       String?
  mapsUrl       String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("institute_settings")
}

model Student {
  id              String @id @default(uuid()) @db.Uuid
  admissionNumber String @unique @default(dbgenerated())

  firstName String
  lastName  String?

  phone String
  email String?

  dateOfBirth DateTime? @db.Date
  gender      String?

  address String?

  status StudentStatus @default(ACTIVE)

  // A student sits in at most one class batch; batches mix courses.
  batchId String? @db.Uuid
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: Restrict)

  // How and by whom the student was admitted. Empty for records created
  // before admissions were tracked.
  admissionSource AdmissionSource?
  admittedById    String?          @db.Uuid
  admittedBy      User?            @relation(fields: [admittedById], references: [id], onDelete: SetNull)

  enrollments Enrollment[]
  enquiries Enquiry[]
  attendance  Attendance[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([status])
  @@index([firstName, lastName])
  @@index([phone])
  @@index([batchId])
  @@index([createdAt])
  @@map("students")
}

// A class time slot. Students of any course can share a batch.
model Batch {
  id String @id @default(uuid()) @db.Uuid

  name String @unique

  days Weekday[]

  // Minutes after midnight, institute local time (e.g. 07:30 -> 450).
  startMinutes Int
  endMinutes   Int

  capacity Int

  instructorId String? @db.Uuid
  instructor   User?   @relation(fields: [instructorId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true)

  students   Student[]
  attendance Attendance[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([isActive])
  @@index([instructorId])
  @@map("batches")
}

// One mark per student, per batch, per class day. History is kept: a batch
// or student with attendance cannot be deleted.
model Attendance {
  id String @id @default(uuid()) @db.Uuid

  batchId   String @db.Uuid
  studentId String @db.Uuid
  date      DateTime @db.Date

  status AttendanceStatus

  markedById String? @db.Uuid
  markedBy   User?   @relation(fields: [markedById], references: [id], onDelete: SetNull)

  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([batchId, studentId, date])
  @@index([batchId, date])
  @@index([studentId, date])
  @@map("attendance")
}

// One row per confirmed Excel import; makes confirmation retries idempotent.
model StudentImportBatch {
  id           String   @id @default(uuid()) @db.Uuid
  requestId    String   @unique @db.Uuid
  fileSha256   String   @db.Char(64)
  studentCount Int
  importedById String?  @db.Uuid
  importedBy   User?    @relation(fields: [importedById], references: [id], onDelete: SetNull)
  result       Json
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([fileSha256])
  @@map("student_import_batches")
}

model Course {
  id String @id @default(uuid()) @db.Uuid

  title String
  slug  String @unique

  shortDescription String?
  description      String?

  category String?

  skills String[] @default([])

  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  enrollments Enrollment[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([isActive])
  @@index([displayOrder])
  @@map("courses")
}

model Enrollment {
  id String @id @default(uuid()) @db.Uuid

  studentId String @db.Uuid
  courseId  String @db.Uuid

  status EnrollmentStatus @default(ACTIVE)

  enrolledAt  DateTime  @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)

  feePlan FeePlan?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([studentId])
  @@index([courseId])
  @@index([status])
  @@map("enrollments")
}

model FeePlan {
  payments Payment[]
  id String @id @default(uuid()) @db.Uuid

  enrollmentId String @unique @db.Uuid

  totalFeePaise Int
  discountPaise Int @default(0)

  dueDate DateTime? @db.Date

  status FeePlanStatus @default(ACTIVE)

  notes String?

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([status])
  @@index([dueDate])
  @@map("fee_plans")
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model Enquiry {
  id String @id @default(uuid()) @db.Uuid
  requestId String @unique @db.Uuid
  name String
  phone String
  email String?
  course String
  message String?
  status EnquiryStatus @default(NEW)
  studentId String? @db.Uuid
  student Student? @relation(fields: [studentId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@index([status])
  @@index([createdAt])
  @@index([studentId])
  @@map("enquiries")
}


model SuperAdminRecoveryCode {
  id String @id @default(uuid()) @db.Uuid

  superAdminId String @db.Uuid
  createdById  String @db.Uuid

  codeHash String

  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([superAdminId, expiresAt])
  @@index([createdById])
  @@map("super_admin_recovery_codes")
}
